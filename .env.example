# ---------------------------------------------------------------
# TeraBooks Player — environment variables
# ---------------------------------------------------------------
# All values are OPTIONAL. The extractor falls back to public
# endpoints when these are not set.

# Optional: a third-party TeraBox extraction proxy you control or trust.
# The route /api/extract will POST { url } to this and expect:
#   { directUrl, title, thumbnail, durationSec, qualities? }
# Leaving this empty makes the app use the built-in extractor strategy.
TERABOX_EXTRACTOR_URL=

# Optional shared-secret header sent to TERABOX_EXTRACTOR_URL.
TERABOX_EXTRACTOR_TOKEN=

# Optional: override the user-agent used by the extractor.
TERABOX_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36"

# Public site URL (used in metadata). Leave default for local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
